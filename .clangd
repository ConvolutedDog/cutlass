CompileFlags:
  Compiler: /usr/local/cuda-12.4/bin/nvcc
  CompilationDatabase: build
  Add:
    - --cuda-path=/usr/local/cuda-12.4
    - --cuda-gpu-arch=sm_90a
    - -I/usr/local/cuda-12.4/include
    - "-xcuda"
    # report all errors
    - "-ferror-limit=0"
    - --cuda-gpu-arch=sm_90a
    - --std=c++17
    - "-D__INTELLISENSE__"
    - "-D__CLANGD__"
    - "-DCUDA_12_0_SM90_FEATURES_SUPPORTED"
    - "-DCUTLASS_ARCH_MMA_SM90_SUPPORTED=1"
    - "-D_LIBCUDACXX_STD_VER=12"
    - "-D__CUDACC_VER_MAJOR__=12"
    - "-D__CUDACC_VER_MINOR__=3"
    - "-D__CUDA_ARCH__=900"
    - "-D__CUDA_ARCH_FEAT_SM90_ALL"
    - "-Wno-invalid-constexpr"
    - -I/home/yangjianchao/Github/cutlass/include/
    - -I/home/yangjianchao/Github/cutlass/tools/util/include/
    - -I/home/yangjianchao/Github/cutlass/tools/library/include/
    - -I/home/yangjianchao/Github/cutlass/tools/profiler/include/
    - -I/home/yangjianchao/Github/cutlass/examples/common/
    - -I/usr/local/cuda-12.4/include
    - -I/home/yangjianchao/Github/cutlass/build/_deps/googletest-src/googletest/include
  Remove:
    # strip CUDA fatbin args
    - "-Xfatbin*"
    # strip CUDA arch flags
    - "-gencode*"
    - "--generate-code*"
    # strip CUDA flags unknown to clang
    - "-ccbin*"
    - "--compiler-options*"
    - "--expt-extended-lambda"
    - "--expt-relaxed-constexpr"
    - "-forward-unknown-to-host-compiler"
    - "-Werror=cross-execution-space-call"
    - "--options-file"
    - "-Xcompiler*"
Hover:
  ShowAKA: Yes
InlayHints:
  Enabled: Yes
Diagnostics:
  Suppress:
    - "variadic_device_fn"
    - "attributes_not_allowed"
